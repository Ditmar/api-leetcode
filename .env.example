# Server Configuration
# PORT=3000
# NODE_ENV=development
# ENV=development
# LOG_LEVEL=info

# JWT Configuration
# Set JWT_SECRET and JWT_REFRESH_TOKEN_SECRET before starting the API.
# Test mode uses fake values from config/test.json.
# Generate each secret independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production requires at least 32 characters; never use the placeholders below.
# JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
# JWT_REFRESH_TOKEN_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
# JWT_EXPIRES_IN=3600000
# JWT_REFRESH_TOKEN_EXPIRES_IN=604800000
# JWT_SALT_ROUNDS=10

# Database Configuration
# Required in production; development uses a local database URL.
# DATABASE_URL="postgresql://username:password@host:5432/database_name?schema=public"
