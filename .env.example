# Server Configuration
# PORT=3000
# NODE_ENV=development
# ENV=development
# LOG_LEVEL=info

# JWT Configuration
# Required in production: JWT_SECRET and JWT_REFRESH_TOKEN_SECRET
# JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
# JWT_REFRESH_TOKEN_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
# JWT_EXPIRES_IN=3600000
# JWT_REFRESH_TOKEN_EXPIRES_IN=604800000
# JWT_SALT_ROUNDS=10

# Database Configuration
# DATABASE_URL="postgresql://username:password@host:5432/database_name?schema=public"