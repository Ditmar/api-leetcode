# Server Configuration
# PORT=0000
# NODE_ENV=development
# ENV=dev
# LOG_LEVEL=info

# JWT Configuration (CHANGE IN PRODUCTION!)
# Secret must be at least 32 characters
# JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars_production
# JWT_EXPIRES_IN=7d

# Bcrypt Configuration
# Salt rounds between 4-31 (10 is recommended, 12+ for high security)
# BCRYPT_SALT_ROUNDS=10

# Database Configuration
#DATABASE_URL="postgresql://username:password@localhost:0000/database_name?schema=public"

# Security (API-010) - validated in src/config/config-schema.ts, all optional.
#
# CORS: allowed origins, comma-separated. Default empty = no cross-origin requests allowed.
# The browser does not call the API directly (Astro proxies it), so it can stay empty.
# CORS_ORIGIN=
#
# Trust proxy: default false = X-Forwarded-For is ignored and req.ip is the socket peer.
# Accepts a hop count (e.g. 1) or comma-separated trusted proxy IPs/subnets. "true" is rejected.
# Behind Astro/Railway, with false every request shares the proxy IP (one rate-limit counter for all users).
# Before setting it in production, verify: how Astro reaches the API (private network or public domain),
# whether Astro overwrites X-Forwarded-For with the real client IP, and which proxy addresses are trusted.
# TRUST_PROXY=false
#
# Rate limiting per client IP, in-memory (each instance/replica keeps its own counters).
# Window shared by the global and auth limiters (default 60000 ms).
# RATE_LIMIT_WINDOW_MS=60000
# Global limit per window (default 100).
# RATE_LIMIT_MAX=100
# Auth limit per window (default 10), counted separately for /api/auth/login, /api/auth/signup
# and /api/auth/refresh. With the defaults, the 11th request in a minute returns HTTP 429.
# AUTH_RATE_LIMIT_MAX=10
#
# Request timeout in ms (default 30000). If no response has started in time, the connection is closed:
# the client gets a connection error (no HTTP status), so Astro must handle it (e.g. show a 504).
# It does NOT cancel work already in progress (DB queries, executions) nor its side effects;
# a late response from the handler is discarded.
# REQUEST_TIMEOUT_MS=30000
#
# JSON body limit: 5 MB (fixed). Larger payloads return HTTP 413.
