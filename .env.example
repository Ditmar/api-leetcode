# Server Configuration
# PORT=0000
# NODE_ENV=development
# ENV=dev
# LOG_LEVEL=info

# JWT Configuration (CHANGE IN PRODUCTION!)
# Secret must be at least 32 characters
# JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars_production
# JWT_EXPIRES_IN=7d

# Bcrypt Configuration
# Salt rounds between 4-31 (10 is recommended, 12+ for high security)
# BCRYPT_SALT_ROUNDS=10

# Database Configuration
# DATABASE_URL="postgresql://username:password@localhost:0000/database_name?schema=public"

# Piston Code Executor Configuration
# PISTON_URL=http://localhost:2000
# PISTON_TOKEN=
# PISTON_COMPILE_TIMEOUT_MS=10000
# PISTON_RUN_TIMEOUT_MS=5000
# PISTON_MEMORY_LIMIT_BYTES=134217728
# PISTON_MAX_OUTPUT_SIZE_BYTES=65536
# PISTON_MAX_CODE_SIZE_BYTES=65536
# PISTON_LANGUAGE_MAP={"javascript":{"language":"javascript","version":"18.15.0"},"python":{"language":"python","version":"3.10.0"}}